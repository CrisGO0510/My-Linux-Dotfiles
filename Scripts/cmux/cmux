#!/usr/bin/env bash

# cmux: varias sesiones de Claude Code en una ventana, sobre dos servidores tmux ocultos.
#   cmux     las sesiones, una por Claude; sobreviven al cierre de la ventana
#   cmux-ui  una sesión por ventana abierta: barra lateral + cliente anidado de la sesión elegida

self=$(realpath "$0")
dir=${self%/*}
export CMUX_BIN=$self
# Los dos servidores se anidan a propósito y todos los destinos van explícitos
unset TMUX TMUX_PANE

core() { tmux -L cmux -f "$dir/core.conf" "$@"; }
ui() { tmux -L cmux-ui -f "$dir/ui.conf" "$@"; }

sessions() {
    core list-sessions -F '#{session_id}|#{session_path}|#{@name}|#{@state}' 2>/dev/null | sort -t'$' -k2n
}

# Pasa por zsh interactivo para heredar la función `claude` del .zshrc (flags y modo de ponytail).
# hooks.json marca en @state si el Claude trabaja, espera respuesta o terminó.
new_session() {
    local d=$1
    shift
    core new-session -dP -F '#{session_id}' -c "$d" -e CMUX=1 -- zsh -ic 'claude --settings "$0" "$@"' "$dir/hooks.json" "$@"
}

open_ui() {
    local name=ui$$
    exec tmux -L cmux-ui -f "$dir/ui.conf" new-session -s "$name" -e "CMUX_UI=$name" \
        "exec env -u TMUX tmux -L cmux attach -t '$1'" \; \
        split-window -hbd -l 26 "exec '$self' _sidebar" \; \
        set @cursor "$1"
}

chat_tty() { ui display -p -t "$CMUX_UI:.{right}" '#{pane_tty}'; }
chat() { core display -p -c "$(chat_tty)" "$1"; }
cursor() { ui show -qv -t "$CMUX_UI" @cursor; }
mode() { ui set -t "$CMUX_UI" @mode "$1" \; set -t "$CMUX_UI" key-table "$2"; }
focus() { ui select-pane -t "$CMUX_UI:.{$1}"; }
show() { core switch-client -c "$(chat_tty)" -t "$1"; }

refresh() {
    local pid
    for pid in $(ui list-sessions -F '#{@sidebar_pid}' 2>/dev/null); do
        kill -USR1 "$pid" 2>/dev/null
    done
}

# tmux reparte el ancho en proporción al cambiar el tamaño de la ventana; la barra debe conservar el suyo
fit() {
    local u
    for u in $(ui list-sessions -F '#{session_name}' 2>/dev/null); do
        ui resize-pane -t "$u:.{left}" -x "$(ui display -p -t "$u" '#{@width}')"
    done
}

widen() {
    local w max
    w=$(($(ui display -p -t "$CMUX_UI" '#{@width}') + $1))
    max=$(($(ui display -p -t "$CMUX_UI" '#{window_width}') - 20))
    ((w > max)) && w=$max
    ((w < 12)) && w=12
    ui set -t "$CMUX_UI" @width "$w"
    fit
}

move() {
    local ids i cur
    mapfile -t ids < <(sessions | cut -d'|' -f1)
    cur=$(cursor)
    for i in "${!ids[@]}"; do
        [[ ${ids[i]} == "$cur" ]] && break
    done
    i=$((i + $1))
    ((i < 0)) && i=0
    ((i >= ${#ids[@]})) && i=$((${#ids[@]} - 1))
    ui set -t "$CMUX_UI" @cursor "${ids[i]}"
}

# En el menú j/k solo mueven el cursor; en el chat cambian de sesión directamente
step() {
    if ((menu)); then
        move "$1"
    else
        ui set -t "$CMUX_UI" @cursor "$(chat '#{session_id}')"
        move "$1"
        show "$(cursor)"
    fi
}

visual() {
    local pane
    pane=$(chat '#{pane_id}')
    focus right
    mode VISUAL root
    core copy-mode -t "$pane"
}

key() {
    local menu d
    menu=$(ui display -p -t "$CMUX_UI" '#{pane_at_left}')
    case $1 in
        esc)
            [[ $(chat '#{pane_in_mode}') == 1 ]] && core send-keys -t "$(chat '#{pane_id}')" -X cancel
            mode NORMAL normal
            ;;
        i)
            focus right
            mode INSERTAR root
            ;;
        h) focus left ;;
        l)
            ((menu)) && show "$(cursor)"
            focus right
            ;;
        j) step 1 ;;
        k) step -1 ;;
        narrow) widen -4 ;;
        widen) widen 4 ;;
        v) visual ;;
        n)
            ui display-popup -E -c "$(ui list-clients -t "$CMUX_UI" -F '#{client_name}')" \
                -w 60% -h 50% "'$self' _pick '$CMUX_UI'"
            ;;
        new)
            d=${2/#\~/$HOME}
            if [[ -d $d ]]; then
                d=$(new_session "$d")
                ui set -t "$CMUX_UI" @cursor "$d"
                show "$d"
                focus right
                mode INSERTAR root
            else
                ui display-message -t "$CMUX_UI" "cmux: no existe la carpeta $d"
            fi
            ;;
        r)
            if ((menu)); then d=$(cursor); else d=$(chat '#{session_id}'); fi
            ui set -t "$CMUX_UI" @target "$d"
            ui command-prompt -t "$(ui list-clients -t "$CMUX_UI" -F '#{client_name}')" \
                -p 'nombre:' -I "$(core display -p -t "$d" '#{?@name,#{@name},#{b:session_path}}')" \
                "run-shell \"'$self' _key rename '$CMUX_UI' '%%'\""
            ;;
        # Relanza el comando original (zsh -ic 'claude …'): recoge el .zshrc y el entorno actuales
        R)
            if ((menu)); then d=$(cursor); else d=$(chat '#{session_id}'); fi
            core respawn-pane -k -t "$d"
            ;;
        # Un nombre vacío devuelve la sesión al nombre de su carpeta
        rename) core set -t "$(ui show -qv -t "$CMUX_UI" @target)" @name "$2" ;;
        d) core kill-session -t "$(cursor)" ;;
        Q)
            core kill-server
            ui kill-server
            ;;
    esac
    refresh
}

# Lista la carpeta de la sesión marcada y los repos y vaults de Obsidian bajo ~; una ruta escrita que no coincide con nada se usa tal cual
pick() {
    local d
    d=$({
        core display -p -t "$(cursor)" '#{session_path}'
        fd -H -t d -d 4 '^\.(git|obsidian)$' "$HOME" -E .cache -E .local --format '{//}'
    } | awk '!seen[$0]++' | sed "s|^$HOME|~|" |
        fzf --print-query --reverse --tiebreak=index --prompt 'carpeta: ')
    d=${d##*$'\n'}
    [[ -n $d ]] && key new "$d"
}

# Al salir del modo de copia (y, Esc) la ventana que estaba en VISUAL vuelve a NORMAL
modesync() {
    for CMUX_UI in $(ui list-sessions -F '#{session_name}' 2>/dev/null); do
        [[ $(ui show -qv -t "$CMUX_UI" @mode) == VISUAL && $(chat '#{pane_in_mode}') != 1 ]] && mode NORMAL normal
    done
    refresh
}

draw() {
    local shown cur menu id path custom state name branch mark icon sgr line out w rows top pad found=
    local -A seen=()
    shown=$(chat '#{session_id}')
    cur=$(cursor)
    menu=$(ui display -p -t "$CMUX_UI" '#{&&:#{pane_at_left},#{==:#{@mode},NORMAL}}')
    w=$(ui display -p -t "$CMUX_UI:.{left}" '#{pane_width}')
    # Las letras de bloque miden 22 columnas; en una barra más estrecha el título cae a una línea
    if ((w >= 24)); then
        top=3
        printf -v pad '%*s' $(((w - 22) / 2)) ''
        out=$'\e[H'"$pad"$'█▀▀      █▄ ▄█ █ █ █ █\e[K\n'
        out+="$pad"$'█        █ ▀ █ █ █  █ \e[K\n'
        out+="$pad"$'█▄▄ \e[2mriko\e[0m █   █ █▄█ █ █\e[K\n\e[K\n'
    else
        top=1
        printf -v out '\e[H%*s\e[1mC\e[22;2mʳⁱᵏᵒ\e[22;1m mux\e[0m\e[K\n\e[K\n' $(((w - 9) / 2)) ''
    fi
    if [[ $(ui list-clients -t "$CMUX_UI" -F '#{client_termname}') == xterm-kitty ]]; then
        # El icono son celdas de texto que tmux conserva: solo se retransmite al cambiar el ancho.
        # Sin --transfer-mode fijo icat consulta a la terminal y la respuesta caería en el panel activo.
        # icat comprueba allow-passthrough con `tmux show`, así que necesita el TMUX que el script borra.
        rows=$(((w - 2) * 2 / 5))
        if [[ $w != "${iconw-}" ]]; then
            printf '\e[2J'
            TMUX=$(ui display -p '#{socket_path}') TMUX_PANE=$(ui display -p -t "$CMUX_UI:.{left}" '#{pane_id}') \
                kitten icat --stdin=no --passthrough=tmux --transfer-mode=stream \
                --place "$((w - 2))x$rows@1x$((top + 1))" "$dir/../../assets/cmux/icono.png" 2>/dev/null
            iconw=$w
        fi
        out+=$'\e['$((rows + top + 3))'H'
    fi
    while IFS='|' read -r id path custom state; do
        name=${custom:-${path##*/}}
        ((++seen[$name] > 1)) && name+=" (${seen[$name]})"
        branch=$(git -C "$path" branch --show-current 2>/dev/null)
        mark=' '
        [[ $id == "$shown" ]] && mark='▸'
        sgr=
        [[ $id == "$cur" ]] && found=1 && ((menu)) && sgr=$'\e[7m'
        case $state in
            working) icon=$'\e[33m●' ;;
            waiting) icon=$'\e[31m?' ;;
            done) icon=$'\e[32m✓' ;;
            *) icon=' ' ;;
        esac
        printf -v line ' %s %-*.*s ' "$mark" $((w - 6)) $((w - 6)) "$name"
        out+="$sgr$line$icon"$'\e[0m\e[K\n'
        if [[ -n $branch ]]; then
            printf -v line '     %-*.*s' $((w - 6)) $((w - 6)) "$branch"
            out+=$'\e[2m'"$sgr$line"$'\e[0m\e[K\n'
        fi
    done < <(sessions)
    printf '%s\e[J' "$out"
    [[ -n $found ]] || ui set -t "$CMUX_UI" @cursor "$shown"
}

sidebar() {
    trap : USR1
    ui set -t "$CMUX_UI" @sidebar_pid $$
    printf '\e[?25l'
    while :; do
        # Sin panel de chat (se cerró el último Claude) la ventana ya no tiene nada que mostrar
        (($(ui list-panes -t "$CMUX_UI" | wc -l) > 1)) || exec tmux -L cmux-ui kill-session -t "$CMUX_UI"
        draw
        sleep 2 &
        wait $!
    done
}

case ${1-} in
    '')
        if [[ -n ${CMUX-} ]]; then
            echo "cmux: ya estás dentro de cmux" >&2
            exit 1
        fi
        id=$(sessions | tail -1 | cut -d'|' -f1)
        open_ui "${id:-$(new_session "$PWD")}"
        ;;
    claude)
        shift
        open_ui "$(new_session "$PWD" "$@")"
        ;;
    active) core has-session 2>/dev/null ;;
    _sidebar) sidebar ;;
    _key)
        CMUX_UI=$3
        key "$2" "${4-}"
        ;;
    _pick)
        CMUX_UI=$2
        pick
        ;;
    _modesync) modesync ;;
    _refresh) refresh ;;
    _fit)
        fit
        refresh
        ;;
    *)
        echo "uso: cmux [claude [args de claude...] | active]" >&2
        exit 2
        ;;
esac
