{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-anthropic-auth"],
  "theme": "tokyonight",
  "autoupdate": true,
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:5000/v1",
        "config": {
          "num_ctx": 16384
        }
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 7B (Cris Local)"
        }
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "git push": "ask",
      "git push --force *": "ask",
      "git rebase *": "ask",
      "git reset --hard *": "ask"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/secrets/**": "deny",
      "**/credentials.json": "deny"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "agent": {
    "qwen": {
      "mode": "primary",
      "provider": "ollama",
      "model": "ollama/qwen2.5-coder:7b",
      "description": "Senior Architect mentor",
      "prompt": "Tu jefe es Cris... (TU PROMPT ACTUAL) ... \n\nIMPORTANTE: No devuelvas NUNCA código JSON ni intentes usar herramientas a menos que Cris te lo pida explícitamente. Si solo te saludan, saludá de forma natural.",
      "tools": {
        "write": true,
        "edit": true
      }
    }
  }
}
