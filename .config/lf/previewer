#!/bin/sh
file="$1"
w="$2"
h="$3"
x="$4"
y="$5"

GLOW_STYLE="dark"

# Sobre SSH el terminal corre en la máquina cliente: no puede leer la memoria
# compartida ni los archivos temporales del host remoto. Hay que mandar los
# bytes por escape codes (stream). Ver `kitten icat --transfer-mode`.
draw() {
  if [ -z "$SSH_CONNECTION$SSH_CLIENT$SSH_TTY" ]; then
    kitten icat --stdin no --transfer-mode memory --place "${w}x${h}@${x}x${y}" "$1" </dev/null >/dev/tty
    exit 1
  fi

  # Cliente con protocolo gráfico de kitty (kitty, ghostty, wezterm...)
  case "$TERM$TERM_PROGRAM" in
    *kitty*|*ghostty*|*[Ww]ez[Tt]erm*)
      kitten icat --stdin no --transfer-mode stream --place "${w}x${h}@${x}x${y}" "$1" </dev/null >/dev/tty
      exit 1
      ;;
  esac

  # Cliente sin soporte gráfico: degradar a bloques unicode/sixel
  if command -v chafa >/dev/null 2>&1; then
    chafa --size="${w}x${h}" "$1"
    exit 0
  fi

  echo "Sin previsualización gráfica en este terminal ($TERM)."
  echo "Instala chafa en el host remoto para ver una versión en texto."
  exit 0
}

video() {
  thumb="/tmp/lf-video-thumb-$(stat -c %i "$1").jpg"
  if [ ! -f "$thumb" ]; then
      ffmpegthumbnailer -i "$1" -o "$thumb" -s 0 2>/dev/null
  fi
  draw "$thumb"
}

pdf() {
  thumb="/tmp/lf-pdf-thumb-$(stat -c %i "$1").jpg"
  
  if [ ! -f "$thumb" ]; then
      pdftoppm -f 1 -l 1 -scale-to-x 1920 -jpeg -singlefile "$1" "${thumb%.jpg}" 2>/dev/null
  fi
  
  draw "$thumb"
}

markdown() {
  COLORTERM=truecolor glow --style="$GLOW_STYLE" --width="$((w - 2))" "$1" 2>&1
  exit 0
}

archive() {
  case "$1" in
    *.tar*) tar tf "$1" 2>&1 ;;
    *.zip) unzip -l "$1" 2>&1 ;;
    *.rar) unrar l "$1" 2>&1 ;;
    *.7z) 7z l "$1" 2>&1 ;;
    *.iso) bsdtar --list --file "$1" 2>&1 ;;
    *) echo "Extensión no soportada." ;;
  esac
  exit 1
}

mime="$(file -Lb --mime-type "$file")"
case "$mime" in 
  image/*)
    draw "$file"
    ;;
  video/*)
    video "$file"
    ;;
  application/pdf)
    pdf "$file"
    ;;
esac

case "$file" in
  *.md|*.markdown)
    markdown "$file"
    ;;
esac

case "$file" in
  *.zip|*.jar|*.war|*.ear|*.oxt)
    archive "$file"
    ;;
  *.tar|*.tar.*|*.tgz|*.tbz2)
    archive "$file"
    ;;
  *.rar)
    archive "$file"
    ;;
  *.7z)
    archive "$file"
    ;;
  *.iso)
    archive "$file"
    ;;
esac

COLORTERM=truecolor bat --color=always --style=numbers --wrap=character --terminal-width="$((w - 2))" --paging=never "$file"
