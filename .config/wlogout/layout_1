{
    "label": "lock",
    "action": "$HOME/dotfiles/Scripts/hypr/lock.sh",
    "text": "Lock",
    "keybind": "l"
}

{
    "label": "logout",
    "action": "$HOME/dotfiles/Scripts/hypr/hyprexit.sh",
    "text": "Logout",
    "keybind": "e"
}

{
    "label": "hibernate",
    "action": "$HOME/dotfiles/Scripts/hypr/lock.sh & disown && systemctl hibernate",
    "text": "Hibernate",
    "keybind": "h"
}

{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "Shutdown",
    "keybind": "s"
}

{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "Reboot",
    "keybind": "r"
}
