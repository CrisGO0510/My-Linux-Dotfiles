/* ================================================
 * Azure Dreams - Clean Modern Rofi Configuration
 * ============================================== */

@import "azure-colors.rasi"

configuration {
    modes:                       "drun,window,run,ssh";
    show-icons:                  true;
    display-drun:                "📦";
    display-window:              "🖥️";
    display-run:                 "⚙️";
    display-ssh:                 "🌐";
    drun-display-format:         "{name}";
    window-format:               "{w}{t}";
    font:                        "JetBrainsMono Nerd Font 10";
    icon-theme:                  "Tela-circle-dracula";
}

/* Azure Dreams Color Scheme imported from azure-colors.rasi */

/* Main Window */
window {
    height:                      33em;
    width:                       63em;
    transparency:                "real";
    fullscreen:                  false;
    enabled:                     true;
    cursor:                      "default";
    spacing:                     0em;
    padding:                     0em;
    border:                      2px;
    border-radius:               16px;
    border-color:                @main-br;
    background-color:            @main-bg;
}

/* Main Container */
mainbox {
    enabled:                     true;
    spacing:                     0em;
    padding:                     0em;
    orientation:                 horizontal;
    children:                    [ "dummywall" , "listbox" ];
    background-color:            transparent;
}

/* Left Side (Wallpaper + Mode Buttons) */
dummywall {
    spacing:                     0em;
    padding:                     0em;
    width:                       38.5em;
    expand:                      false;
    orientation:                 horizontal;
    children:                    [ "mode-switcher" , "inputbar" ];
    background-color:            transparent;
    background-image:            url("/tmp/rofi_wallpapers/wall_main.jpg", height);
}

/* Mode Switcher */
mode-switcher{
    orientation:                 vertical;
    enabled:                     true;
    width:                       6em;
    padding:                     8.5em 1.2em 8.5em 1.2em;
    spacing:                     1.5em;
    background-color:            transparent;
    background-image:            url("/tmp/rofi_wallpapers/wall_blur.jpg", height);
    border-radius:               16px 0px 0px 16px;
}

button {
    cursor:                      pointer;
    border-radius:               12px;
    padding:                     12px;
    background-color:            @main-bg;
    text-color:                  @main-fg;
    font:                        "JetBrainsMono Nerd Font 18";
}

button selected {
    background-color:            @main-bg-alt;
    text-color:                  @accent-blue;
    border:                      1px;
    border-color:                @main-br;
    font:                        "JetBrainsMono Nerd Font 18";
}

/* Input Bar */
inputbar {
    enabled:                     true;
    children:                    [ "entry" ];
    background-color:            transparent;
}

entry {
    enabled:                     false;
}

/* List Container */
listbox {
    spacing:                     0em;
    padding:                     2.5em;
    children:                    [ "dummy" , "listview" , "dummy" ];
    background-color:            transparent;
    border-radius:               0px 16px 16px 0px;
}

listview {
    enabled:                     true;
    spacing:                     0.5em;
    padding:                     1em;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    expand:                      false;
    fixed-height:                true;
    fixed-columns:               true;
    cursor:                      "default";
    background-color:            @main-bg-alt;
    text-color:                  @main-fg;
    border-radius:               12px;
}

dummy {
    background-color:            transparent;
}

/* List Elements */
element {
    enabled:                     true;
    spacing:                     1em;
    padding:                     0.8em 1em;
    cursor:                      pointer;
    background-color:            @element-bg;
    text-color:                  @main-fg;
    border-radius:               8px;
}

element selected.normal {
    background-color:            @select-bg;
    text-color:                  @select-fg;
    border:                      1px;
    border-color:                @main-br;
}

element normal.normal {
    background-color:            @element-bg;
    text-color:                  @main-fg;
}

element alternate.normal {
    background-color:            @element-bg;
    text-color:                  @main-fg;
}

element-icon {
    size:                        3.2em;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
    border-radius:               6px;
}

element-text {
    vertical-align:              0.5;
    horizontal-align:            0.0;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
    font:                        "JetBrainsMono Nerd Font 11";
}

/* Error Messages */
error-message {
    text-color:                  @main-fg;
    background-color:            @main-bg;
    text-transform:              capitalize;
    children:                    [ "textbox" ];
}

textbox {
    text-color:                  inherit;
    background-color:            inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
